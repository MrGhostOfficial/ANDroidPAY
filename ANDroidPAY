# hide cursor
tput civis
while kill -0 "$pid" 2>/dev/null; do
    for i in "${spinner[@]}"; do

        # stop instantly if process finished
        kill -0 "$pid" 2>/dev/null || break

        printf "\r\033[K\033[1;32mDownloading Please wait...\033[1;33m [%s]\033[0m" "$i"

        sleep "$delay"
    done
done
wait "$pid" 2>/dev/null
# show cursor
tput cnorm
printf "\r\033[K\033[0;31m[\033[1;32mDone!\033[0;31m]\033[0m\n"
echo ''
}
