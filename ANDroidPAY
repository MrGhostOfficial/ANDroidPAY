# Get LPORT from user
function get_lport() {
  local lport_val=""
  while true; do
    read -rp "${aqua}[?] Enter LocalPort (ex:${green} 6666 ) ${normal}" lport_val
    if [[ "$lport_val" =~ ^[0-9]+$ ]] && [ "$lport_val" -gt 0 ] && [ "$lport_val" -le 65535 ]; then
      break
    else
      display_warning "Invalid LPORT. Please enter a number between 1 and 65535."
    fi
  done
  echo "$lport_val"
}
